# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | deepseek | gemini | anthropic
# Nhóm đang dùng deepseek: rẻ, nhanh, tương thích chuẩn OpenAI SDK.
LLM_PROVIDER=deepseek
# Để trống thì dùng model mặc định của provider (xem DEFAULT_MODELS trong
# src/task10_generation.py), với deepseek là deepseek-chat.
LLM_MODEL=

# Generation providers — chỉ cần key của provider đã chọn ở trên.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
# Mặc định chạy local, không cần API key. Model phải hiểu tiếng Việt —
# all-MiniLM-L6-v2 (tiếng Anh) đã được thử và loại, xem comment trong
# src/task4_chunking_indexing.py.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Optional services. Thiếu PAGEINDEX_API_KEY thì Task 8 trả về rỗng và
# Task 9 tự quay lại dùng hybrid result — pipeline vẫn chạy bình thường.
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Ngưỡng cosine của dense search để quyết định fallback. Đã hiệu chỉnh trên
# corpus hiện tại: in-domain 0.621-0.874, out-of-domain 0.105-0.442.
# Đổi corpus hoặc embedding model thì phải đo lại.
SCORE_THRESHOLD=0.53
